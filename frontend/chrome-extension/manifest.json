{
  "manifest_version": 3,
  "name": "NeuroAccess",
  "version": "1.0",

  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],

  "action": {
    "default_popup": "src/popup.html"
  },

  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
  {
    "resources": ["*.png", "icons/*"],
    "matches": ["<all_urls>"]
  }
],


  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/styles/content.css"]
    }]

  
}