# NeuroAccess environment template
# Copy this file to .env and fill values as needed.

# Build/runtime mode
# Do not set NODE_ENV here unless you have a specific reason.
# Webpack mode already controls NODE_ENV for build and dev scripts.

# Optional API keys/endpoints for accessibility features
# Current code mostly reads these from extension settings UI,
# but keeping them here helps future-proof local setup.
AZURE_VISION_API_KEY=
AZURE_VISION_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/vision/v3.2/analyze

# Optional AI providers (documented in README)
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional billing provider
STRIPE_PUBLISHABLE_KEY=
